# Server Port & Runtime Environment
PORT=5000
NODE_ENV=development
LOG_LEVEL=debug

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/iehub?retryWrites=true&w=majority

# Client Application URL for CORS (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173

# Platform Administrators (comma-separated email addresses)
# In production, ONLY users in this list receive Platform Admin privileges.
ADMIN_EMAILS=admin@importexport.com

# Development Sandbox Bypass (NEVER enable in production)
# When set to true in development, allows testing with synthetic tokens (guest-token-*, demo-admin-token)
ENABLE_DEV_SANDBOX=false

# Public Firebase Web Client Configuration (Served via GET /api/config)
FIREBASE_API_KEY=your_firebase_web_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase Admin SDK Credentials (Optional for local dev fallback; Recommended for production)
# Can be a raw JSON string or base64 encoded service account JSON
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
